@page
@model MedicalSystem.Pages.PatientRecordPages.DeleteModel

@{
    ViewData["Title"] = "Obriši zapis";
}

<h1>Obriši zapis</h1>

<h3>Jeste li sigurni da želite obrisati ovaj zapis?</h3>

<div>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">
            Pacijent
        </dt>
        <dd class="col-sm-9">
            @Model.PatientRecord.Patient?.FirstName @Model.PatientRecord.Patient?.LastName
        </dd>

        <dt class="col-sm-3">
            Bolest
        </dt>
        <dd class="col-sm-9">
            @Model.PatientRecord.Disease?.Name
        </dd>

        <dt class="col-sm-3">
            Datum početka
        </dt>
        <dd class="col-sm-9">
            @Model.PatientRecord.StartDate.ToString("dd.MM.yyyy.")
        </dd>

        <dt class="col-sm-3">
            Datum završetka
        </dt>
        <dd class="col-sm-9">
            @(Model.PatientRecord.EndDate.HasValue
                ? Model.PatientRecord.EndDate.Value.ToString("dd.MM.yyyy.")
                : "Nije završeno")
        </dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="PatientRecord.Id" />

        <input type="submit" value="Obriši" class="btn btn-danger" />
        <a asp-page="./Index" class="btn btn-secondary ms-2">Odustani</a>
    </form>
</div>