@page
@model MedicalSystem.Pages.PatientRecordPages.DetailsModel

@{
    ViewData["Title"] = "Detalji zapisa";
}

<h1>Detalji zapisa</h1>

<div>
    <h4>Patient Record</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            Pacijent
        </dt>
        <dd class="col-sm-10">
            @(Model.PatientRecord.Patient != null
                ? $"{Model.PatientRecord.Patient.FirstName} {Model.PatientRecord.Patient.LastName}"
                : "-")
        </dd>

        <dt class="col-sm-2">
            Bolest
        </dt>
        <dd class="col-sm-10">
            @(Model.PatientRecord.Disease?.Name ?? "-")
        </dd>

        <dt class="col-sm-2">
            Početak
        </dt>
        <dd class="col-sm-10">
            @Model.PatientRecord.StartDate.ToString("dd.MM.yyyy.")
        </dd>

        <dt class="col-sm-2">
            Kraj
        </dt>
        <dd class="col-sm-10">
            @(Model.PatientRecord.EndDate.HasValue
                ? Model.PatientRecord.EndDate.Value.ToString("dd.MM.yyyy.")
                : "-")
        </dd>
    </dl>
</div>

<div>
    <a asp-page="./Edit" asp-route-id="@Model.PatientRecord.Id">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>