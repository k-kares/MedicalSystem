@page
@model MedicalSystem.Pages.PrescriptionPages.DetailsModel

@{
    ViewData["Title"] = "Detalji recepta";
}

<h1>Detalji recepta</h1>

<div>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            Pacijent
        </dt>
        <dd class="col-sm-10">
            @(Model.Prescription.Patient != null
                ? $"{Model.Prescription.Patient.FirstName} {Model.Prescription.Patient.LastName}"
                : "-")
        </dd>

        <dt class="col-sm-2">
            Liječnik
        </dt>
        <dd class="col-sm-10">
            @(Model.Prescription.Doctor != null
                ? $"{Model.Prescription.Doctor.FirstName} {Model.Prescription.Doctor.LastName}"
                : "-")
        </dd>

        <dt class="col-sm-2">
            Lijek
        </dt>
        <dd class="col-sm-10">
            @(Model.Prescription.Medication?.Name ?? "-")
        </dd>

        <dt class="col-sm-2">
            Doza
        </dt>
        <dd class="col-sm-10">
            @Model.Prescription.Dose
        </dd>

        <dt class="col-sm-2">
            Jedinica doze
        </dt>
        <dd class="col-sm-10">
            @Model.Prescription.DoseUnit
        </dd>

        <dt class="col-sm-2">
            Učestalost
        </dt>
        <dd class="col-sm-10">
            @Model.Prescription.Frequency
        </dd>

        <dt class="col-sm-2">
            Početak
        </dt>
        <dd class="col-sm-10">
            @Model.Prescription.StartDate.ToString("dd.MM.yyyy.")
        </dd>

        <dt class="col-sm-2">
            Kraj
        </dt>
        <dd class="col-sm-10">
            @(Model.Prescription.EndDate.HasValue
                ? Model.Prescription.EndDate.Value.ToString("dd.MM.yyyy.")
                : "-")
        </dd>
    </dl>
</div>

<div>
    <a asp-page="./Edit" asp-route-id="@Model.Prescription.Id">Uredi</a> |
    <a asp-page="./Index">Natrag na popis</a>
</div>