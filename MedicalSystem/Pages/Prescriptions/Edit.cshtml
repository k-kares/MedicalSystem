@page
@model MedicalSystem.Pages.PrescriptionPages.EditModel

@{
    ViewData["Title"] = "Uredi recept";
}

<h1>Uredi recept</h1>

<h4>Prescription</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form method="post">

            <div asp-validation-summary="All" class="text-danger"></div>

            <input type="hidden" asp-for="Prescription.Id" />

            <div class="form-group mb-3">
                <label asp-for="Prescription.PatientId" class="control-label">Pacijent</label>
                <select asp-for="Prescription.PatientId"
                        asp-items="Model.PatientList"
                        class="form-control">
                    <option value="">-- Odaberite pacijenta --</option>
                </select>
                <span asp-validation-for="Prescription.PatientId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Prescription.DoctorId" class="control-label">Liječnik</label>
                <select asp-for="Prescription.DoctorId"
                        asp-items="Model.DoctorList"
                        class="form-control">
                    <option value="">-- Odaberite liječnika --</option>
                </select>
                <span asp-validation-for="Prescription.DoctorId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Prescription.MedicationId" class="control-label">Lijek</label>
                <select asp-for="Prescription.MedicationId"
                        asp-items="Model.MedicationList"
                        class="form-control">
                    <option value="">-- Odaberite lijek --</option>
                </select>
                <span asp-validation-for="Prescription.MedicationId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Prescription.Dose" class="control-label">Doza</label>
                <input asp-for="Prescription.Dose" class="form-control" />
                <span asp-validation-for="Prescription.Dose" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Prescription.DoseUnit" class="control-label">Jedinica doze</label>
                <input asp-for="Prescription.DoseUnit" class="form-control" />
                <span asp-validation-for="Prescription.DoseUnit" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Prescription.Frequency" class="control-label">Učestalost</label>
                <input asp-for="Prescription.Frequency" class="form-control" />
                <span asp-validation-for="Prescription.Frequency" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Prescription.StartDate" class="control-label">Početak</label>
                <input asp-for="Prescription.StartDate"
                       type="date"
                       class="form-control" />
                <span asp-validation-for="Prescription.StartDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Prescription.EndDate" class="control-label">Kraj</label>
                <input asp-for="Prescription.EndDate"
                       type="date"
                       class="form-control" />
                <span asp-validation-for="Prescription.EndDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Spremi" class="btn btn-primary" />
            </div>

        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-page="./Index">Natrag na popis</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}