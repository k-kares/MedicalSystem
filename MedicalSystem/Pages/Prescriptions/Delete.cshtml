@page
@model MedicalSystem.Pages.PrescriptionPages.DeleteModel

@{
ViewData["Title"] = "Izbriši recept";
}

<h1>Izbriši recept</h1>

<h3>Jeste li sigurni da želite izbrisati ovaj recept?</h3>

<div>
    <hr />

<dl class="row">
    <dt class="col-sm-3">
        Pacijent
    </dt>
    <dd class="col-sm-9">
        @Model.Prescription.Patient?.FirstName @Model.Prescription.Patient?.LastName
    </dd>

    <dt class="col-sm-3">
        Liječnik
    </dt>
    <dd class="col-sm-9">
        @Model.Prescription.Doctor?.FirstName @Model.Prescription.Doctor?.LastName
    </dd>

    <dt class="col-sm-3">
        Lijek
    </dt>
    <dd class="col-sm-9">
        @Model.Prescription.Medication?.Name
    </dd>

    <dt class="col-sm-3">
        Doza
    </dt>
    <dd class="col-sm-9">
        @Model.Prescription.Dose @Model.Prescription.DoseUnit
    </dd>

    <dt class="col-sm-3">
        Učestalost
    </dt>
    <dd class="col-sm-9">
        @Model.Prescription.Frequency
    </dd>

    <dt class="col-sm-3">
        Datum početka
    </dt>
    <dd class="col-sm-9">
        @Model.Prescription.StartDate.ToString("dd.MM.yyyy.")
    </dd>

    <dt class="col-sm-3">
        Datum završetka
    </dt>
    <dd class="col-sm-9">
        @(Model.Prescription.EndDate.HasValue
            ? Model.Prescription.EndDate.Value.ToString("dd.MM.yyyy.")
            : "Nije završeno")
    </dd>
</dl>

<form method="post">
    <input type="hidden" asp-for="Prescription.Id" />

    <input type="submit" value="Izbriši" class="btn btn-danger" />
    <a asp-page="./Index" class="btn btn-secondary ms-2">Natrag na popis</a>
</form>


</div>
