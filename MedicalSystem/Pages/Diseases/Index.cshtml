@page
@model MedicalSystem.Pages.DiseasePages.IndexModel

@{
    ViewData["Title"] = "Bolesti";
}

<h1>Bolesti</h1>

<p>
    <a asp-page="Create">Napravi novu bolest</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Disease[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Disease[0].Description)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Disease) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.Description)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Uredi</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Detalji</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Izbriši</a>
            </td>
        </tr>
}
    </tbody>
</table>
