@page
@model MedicalSystem.Pages.DiseasePages.DeleteModel

@{
    ViewData["Title"] = "Izbriši bolest";
}

<h1>Izbriši bolest</h1>

<h3>Jeste li sigurni da želite izbrisati ovu bolest?</h3>
<div>
    <h4>MedicalSystem.Models.Disease</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Disease.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Disease.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Disease.Description)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Disease.Description)
        </dd>
    </dl>
    <form method="post">
        <input type="hidden" asp-for="Disease.Id" />
        <input type="submit" value="Izbriši" class="btn btn-danger" /> |
        <a asp-page="./Index">Natrag na listu</a>
    </form>
</div>
