@page
@model MedicalSystem.Pages.DiseasePages.CreateModel

@{
    ViewData["Title"] = "Napravi bolest";
}

<h1>Napravi bolest</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Disease.Name" class="control-label"></label>
                <input asp-for="Disease.Name" class="form-control" />
                <span asp-validation-for="Disease.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Disease.Description" class="control-label"></label>
                <input asp-for="Disease.Description" class="form-control" />
                <span asp-validation-for="Disease.Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Napravi" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Natrag na listu</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
