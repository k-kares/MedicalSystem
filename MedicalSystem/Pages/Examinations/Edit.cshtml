@page
@model MedicalSystem.Pages.ExaminationPages.EditModel

@{
    ViewData["Title"] = "Uredi pregled";
}

<h1>Uredi pregled</h1>

<h4>Examination</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form method="post">

            <div asp-validation-summary="All" class="text-danger"></div>

            <input type="hidden" asp-for="Examination.Id" />

            <div class="form-group mb-3">
                <label asp-for="Examination.PatientId" class="control-label">
                    Pacijent
                </label>
                <select asp-for="Examination.PatientId"
                        asp-items="Model.PatientList"
                        class="form-control">
                    <option value="">-- Odaberite pacijenta --</option>
                </select>
                <span asp-validation-for="Examination.PatientId"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Examination.DoctorId" class="control-label">
                    Liječnik
                </label>
                <select asp-for="Examination.DoctorId"
                        asp-items="Model.DoctorList"
                        class="form-control">
                    <option value="">-- Odaberite liječnika --</option>
                </select>
                <span asp-validation-for="Examination.DoctorId"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Examination.Type" class="control-label">
                    Vrsta pregleda
                </label>
                <input asp-for="Examination.Type"
                       class="form-control" />
                <span asp-validation-for="Examination.Type"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Examination.ScheduledAt" class="control-label">
                    Datum i vrijeme pregleda
                </label>
                <input asp-for="Examination.ScheduledAt"
                       type="datetime-local"
                       class="form-control" />
                <span asp-validation-for="Examination.ScheduledAt"
                      class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit"
                       value="Spremi"
                       class="btn btn-primary" />
            </div>

        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-page="./Index">Natrag na popis</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}