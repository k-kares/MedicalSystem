@page
@model MedicalSystem.Pages.ExaminationPages.DeleteModel

@{
ViewData["Title"] = "Obriši pregled";
}

<h1>Obriši pregled</h1>

<h3>Jeste li sigurni da želite obrisati ovaj pregled?</h3>

<div>
    <hr />

<dl class="row">
    <dt class="col-sm-3">
        Pacijent
    </dt>
    <dd class="col-sm-9">
        @Model.Examination.Patient?.FirstName @Model.Examination.Patient?.LastName
    </dd>

    <dt class="col-sm-3">
        Liječnik
    </dt>
    <dd class="col-sm-9">
        @Model.Examination.Doctor?.FirstName @Model.Examination.Doctor?.LastName
    </dd>

    <dt class="col-sm-3">
        Vrsta pregleda
    </dt>
    <dd class="col-sm-9">
        @Model.Examination.Type
    </dd>

    <dt class="col-sm-3">
        Termin pregleda
    </dt>
    <dd class="col-sm-9">
        @Model.Examination.ScheduledAt.ToString("dd.MM.yyyy. HH:mm")
    </dd>
</dl>

<form method="post">
    <input type="hidden" asp-for="Examination.Id" />

    <input type="submit" value="Obriši" class="btn btn-danger" />
    <a asp-page="./Index" class="btn btn-secondary ms-2">Natrag na popis</a>
</form>

</div>
