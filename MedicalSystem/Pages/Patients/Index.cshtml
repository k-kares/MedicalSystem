@page
@model MedicalSystem.Pages.PatientPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Pacijenti</h1>

<p>
    <a asp-page="Create">Napravi novog</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Ime
            </th>
            <th>
                Prezime
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Patient[0].OIB)
            </th>
            <th>
                Datum rođenja
            </th>
            <th>
                Spol
            </th>
            <th>
                Adresa prebivališta
            </th>
            <th>
                Trajna adresa
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Patient) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.FirstName)
            </td>
            <td>
                @Html.DisplayFor(model => item.LastName)
            </td>
            <td>
                @Html.DisplayFor(model => item.OIB)
            </td>
            <td>
                    @item.DateOfBirth.ToString("dd.MM.yyyy.")
            </td>
            <td>
                @Html.DisplayFor(model => item.Gender)
            </td>
            <td>
                @Html.DisplayFor(model => item.ResidenceAddress)
            </td>
            <td>
                @Html.DisplayFor(model => item.PermanentAddress)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Uredi</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Detalji</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Izbriši</a>
            </td>
        </tr>
}
    </tbody>
</table>
