@page
@model MedicalSystem.Pages.PatientPages.DeleteModel

@{
    ViewData["Title"] = "Izbriši";
}

<h1>Izbriši</h1>

<h3>Jeste li sigurni da želite izbrisati ovaj unos?</h3>
<div>
    <h4>MedicalSystem.Models.Patient</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Patient.FirstName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Patient.FirstName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Patient.LastName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Patient.LastName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Patient.OIB)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Patient.OIB)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Patient.DateOfBirth)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Patient.DateOfBirth)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Patient.Gender)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Patient.Gender)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Patient.ResidenceAddress)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Patient.ResidenceAddress)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Patient.PermanentAddress)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Patient.PermanentAddress)
        </dd>
    </dl>
    <form method="post">
        <input type="hidden" asp-for="Patient.Id" />
        <input type="submit" value="Izbriši" class="btn btn-danger" /> |
        <a asp-page="./Index">Natrag na popis</a>
    </form>
</div>
