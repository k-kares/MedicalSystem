@page
@model MedicalSystem.Pages.MedicationPages.DeleteModel

@{
    ViewData["Title"] = "Izbriši lijek";
}

<h1>Izbriši lijek</h1>

<h3>Jeste li sigurni da želite izbrisati ovaj lijek?</h3>
<div>
    <h4>MedicalSystem.Models.Medication</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Medication.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Medication.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Medication.Description)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Medication.Description)
        </dd>
    </dl>
    <form method="post">
        <input type="hidden" asp-for="Medication.Id" />
        <input type="submit" value="Izbriši" class="btn btn-danger" /> |
        <a asp-page="./Index">Natrag na popis</a>
    </form>
</div>
