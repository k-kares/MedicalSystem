@page
@model MedicalSystem.Pages.MedicationPages.EditModel

@{
    ViewData["Title"] = "Uredi lijek";
}

<h1>Uredi lijek</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Medication.Id" />
            <div class="form-group">
                <label asp-for="Medication.Name" class="control-label"></label>
                <input asp-for="Medication.Name" class="form-control" />
                <span asp-validation-for="Medication.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Medication.Description" class="control-label"></label>
                <input asp-for="Medication.Description" class="form-control" />
                <span asp-validation-for="Medication.Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Natrag na popis</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
